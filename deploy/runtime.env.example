# Copy to ignored deploy/runtime.env. Preserve reviewed current trading settings.
# Defaults are deliberately inactive in staging; no real Telegram or scans.
STOCK_SCANNER_ENABLED=false
STOCK_SCANNER_TELEGRAM_ENABLED=false
STOCK_SCANNER_TELEGRAM_ENTRY_ALERTS=false
STOCK_SCANNER_TELEGRAM_LEVEL_ALERTS=false
STOCK_SCANNER_TELEGRAM_PORTFOLIO_STATUS_ENABLED=false
TELEGRAM_NEWS_READER_ENABLED=false
TELEGRAM_NEWS_STREAM_ENABLED=false
CLAWTRADER_CORS_ORIGINS=https://aviramdahan.github.io
# Explicit model selection required; no local fallback and no default cloud spend.
OPENROUTER_NEWS_MODEL=
OPENROUTER_SUMMARY_MODEL=
STOCK_SCANNER_FINAL_AI_MODEL=
AI_TIMEOUT_SECONDS=120
AI_MONTHLY_BUDGET_USD=20
# Set to the final UTC handover timestamp before enabling cloud news Telegram.
# Older news can still be analyzed; it must not be rebroadcast after clean import.
TELEGRAM_NEWS_NOT_BEFORE=
# Non-secret routing IDs and provider settings go here after staging review.
