# ==================== Environment ====================
ENVIRONMENT=development

# ==================== Database ====================
# Choose ONE backend:
#
# 1) PostgreSQL (recommended for shared/production deployments)
#    Set DATABASE_URL and leave DB_PATH unused.
#    Example:
#    DATABASE_URL=postgresql://ai_trader:change-me@127.0.0.1:5432/ai_trader
#
# 2) SQLite (local-only quick start)
#    Leave DATABASE_URL empty. The API uses DB_PATH below.
#
# Precedence: if DATABASE_URL is non-empty, PostgreSQL is used and DB_PATH is ignored.
# Unit tests may set ALLOW_SQLITE=true when exercising SQLite helpers.
DATABASE_URL=

# SQLite file path — only used when DATABASE_URL is empty.
DB_PATH=service/server/data/clawtrader.db

# ==================== API Keys ====================
ALPHA_VANTAGE_API_KEY=demo
# Optional: enrich US stock market-intel snapshots with Adanos social/news/prediction-market sentiment.
ADANOS_API_KEY=

# Optional AI-generated market summaries. Local Ollama requires no API key.
# If both providers are configured, OpenRouter is attempted first and Ollama is the fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
# Optional installed local model dedicated to Hebrew news (e.g. gemma3:12b).
OLLAMA_NEWS_MODEL=
STOCK_SCANNER_NEWS_ANALYSIS_MAX_ATTEMPTS=6
OLLAMA_TIMEOUT_SECONDS=120

# ==================== Frontend ====================
# Frontend auto-refresh interval in milliseconds.
VITE_REFRESH_INTERVAL=300000
# Optional absolute backend API URL for split-origin deployments such as GitHub Pages.
# Example: https://your-backend.example.com/api
VITE_API_BASE=

# ==================== Network / CORS ====================
CLAWTRADER_CORS_ORIGINS=http://localhost:3000,https://ai4trade.ai

# Optional comma-separated agent names/IDs with all admin capabilities.
AI_TRADER_ADMIN_AGENTS=

# For a simple local all-in-one process. Production deployments should keep this
# false and run service/server/worker.py separately on a POSIX host.
AI_TRADER_API_BACKGROUND_TASKS=false

# ==================== Market Data Endpoints ====================
ADANOS_API_BASE_URL=https://api.adanos.org
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_BASE_URL=https://clob.polymarket.com

# ==================== Background Tasks ====================
POSITION_REFRESH_INTERVAL=300
MAX_PARALLEL_PRICE_FETCH=5
POLYMARKET_SETTLE_INTERVAL=60
MARKET_NEWS_REFRESH_INTERVAL=900
MACRO_SIGNAL_REFRESH_INTERVAL=900
ETF_FLOW_REFRESH_INTERVAL=900
STOCK_ANALYSIS_REFRESH_INTERVAL=1800
STOCK_SCANNER_ENABLED=false
# Automatic constituent sources. Supported: sp500,nasdaq100 (comma-separated).
STOCK_SCANNER_UNIVERSE=sp500,nasdaq100
STOCK_SCANNER_SCAN_INTERVAL=1800
STOCK_SCANNER_SHORTLIST_LIMIT=25
STOCK_SCANNER_AI_CANDIDATE_LIMIT=6
STOCK_SCANNER_MAX_SIGNALS_PER_SCAN=3
STOCK_SCANNER_MIN_DOLLAR_VOLUME=50000000
STOCK_SCANNER_MIN_ATR_PCT=1.0
STOCK_SCANNER_MAX_ATR_PCT=8.0
STOCK_SCANNER_MIN_CONFIDENCE=0.80
STOCK_SCANNER_MIN_RISK_REWARD=2.0
STOCK_SCANNER_DUPLICATE_COOLDOWN_HOURS=24
STOCK_SCANNER_NEWS_MAX_AGE_HOURS=72
STOCK_SCANNER_PAPER_NOTIONAL=100
STOCK_SCANNER_MAX_SYMBOL_EXPOSURE=250
STOCK_SCANNER_MAX_TOTAL_EXPOSURE=1000
STOCK_SCANNER_MIN_TECHNICAL_SCORE=5
STOCK_SCANNER_UNIVERSE_CACHE_TTL_SECONDS=86400
# Full-universe daily OHLCV refresh: once per 20 hours; stale fallback fails closed after four days.
STOCK_SCANNER_HISTORY_CACHE_TTL_SECONDS=72000
STOCK_SCANNER_HISTORY_STALE_AFTER_SECONDS=345600
STOCK_SCANNER_NEWS_CACHE_TTL_SECONDS=900
# Persistent server-side news feed. Five minutes is the minimum supported
# cadence; Yahoo is intentionally slower and covers a prioritized rotating set.
STOCK_SCANNER_NEWS_FEED_ENABLED=true
STOCK_SCANNER_GENERAL_NEWS_ENABLED=true
# Public community join link, appended only to news Telegram messages.
TELEGRAM_COMMUNITY_URL=
TELEGRAM_NEWS_READER_ENABLED=false
TELEGRAM_NEWS_SOURCE_CHANNELS=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
STOCK_SCANNER_GENERAL_NEWS_MIN_RELEVANCE=0.5
STOCK_SCANNER_GENERAL_NEWS_MAX_AGE_HOURS=6
STOCK_SCANNER_NEWS_FEED_INTERVAL_SECONDS=300
STOCK_SCANNER_NEWS_FEED_MAX_AGE_HOURS=168
STOCK_SCANNER_YAHOO_NEWS_INTERVAL_SECONDS=900
STOCK_SCANNER_YAHOO_NEWS_TICKERS_PER_CYCLE=10
# Idle wait only; ready stories drain immediately, never sleep per story.
STOCK_SCANNER_NEWS_AI_INTERVAL_SECONDS=2
# Source-only market translation, strict fallback for suspicious output.
STOCK_SCANNER_NEWS_FAST_MARKET=false
# Single Telegram session owner with live updates and durable 60s catch-up.
TELEGRAM_NEWS_STREAM_ENABLED=false
STOCK_SCANNER_NEWS_AI_BATCH_SIZE=3
STOCK_SCANNER_NEWS_ALERT_MIN_RELEVANCE=0.65
# SEC fair-access identification (operator/product plus a real contact email).
# This is server-only configuration, not an API secret.
NEWS_SEC_USER_AGENT=
# Bounded SEC Submissions API catch-up. Open positions/watchlist are checked first.
STOCK_SCANNER_SEC_SUBMISSIONS_PER_CYCLE=4
# Shared SEC request spacing (0.12s stays below the published fair-access ceiling).
STOCK_SCANNER_SEC_REQUEST_GAP_SECONDS=0.12
STOCK_SCANNER_LEVEL_MONITOR_INTERVAL=300
# Display-only batched 1-minute quotes. These do not trigger fills and Yahoo may delay them.
STOCK_SCANNER_QUOTE_REFRESH_SECONDS=30
# Durable paper lifecycle. The default existing single-target exit remains active;
# staged is evaluated in an isolated shadow record until explicitly selected.
STOCK_SCANNER_EXIT_STRATEGY=single
STOCK_SCANNER_SIGNAL_VALIDITY_HOURS=24
STOCK_SCANNER_INITIAL_CASH=100000
STOCK_SCANNER_SIM_SLIPPAGE_BPS=2
STOCK_SCANNER_SIM_COMMISSION_PER_SHARE=0.005
STOCK_SCANNER_SIM_MIN_COMMISSION=0.25
STOCK_SCANNER_BREAKEVEN_THRESHOLD=0.50
# entry keeps the stop at actual entry after TP2; tp1 advances it to TP1.
STOCK_SCANNER_STAGED_STOP_AFTER_TP2=entry
# Open-position news runs independently of market hours and price monitoring.
STOCK_SCANNER_POSITION_NEWS_INTERVAL_HOURS=6
STOCK_SCANNER_POSITION_NEWS_OVERLAP_HOURS=2
# Optional Telegram notifications. Token and chat ID are secrets and belong only in ignored .env.
STOCK_SCANNER_TELEGRAM_ENABLED=false
STOCK_SCANNER_TELEGRAM_ENTRY_ALERTS=false
STOCK_SCANNER_TELEGRAM_LEVEL_ALERTS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Telegram Forum topic IDs. News and trade lifecycle alerts remain in General when unset.
TELEGRAM_NEWS_THREAD_ID=
TELEGRAM_TRADING_THREAD_ID=
TELEGRAM_MARKET_NEWS_THREAD_ID=
TELEGRAM_STOCK_NEWS_THREAD_ID=
TELEGRAM_PERSONAL_NEWS_THREAD_ID=
STOCK_SCANNER_EXTENDED_EXITS_FROM=
TELEGRAM_SIGNALS_THREAD_ID=
TELEGRAM_TRADES_THREAD_ID=
TELEGRAM_PORTFOLIO_THREAD_ID=
STOCK_SCANNER_TELEGRAM_PORTFOLIO_STATUS_ENABLED=true
STOCK_SCANNER_TELEGRAM_PORTFOLIO_STATUS_INTERVAL=300
STOCK_SCANNER_TELEGRAM_BROAD_NEWS_MIN_RELEVANCE=0.80
# Secret; provision locally with scripts/configure_stock_scanner.py. Never expose to frontend.
STOCK_SCANNER_TOKEN=
ADANOS_SENTIMENT_CACHE_TTL_SECONDS=300
ADANOS_SENTIMENT_TIMEOUT_SECONDS=4

# ==================== Profit History Retention ====================
# Keep recent history at full resolution.
PROFIT_HISTORY_FULL_RESOLUTION_HOURS=24

# Keep compacted history inside this rolling window.
PROFIT_HISTORY_COMPACT_WINDOW_DAYS=7

# Bucket size used when compacting older profit history.
PROFIT_HISTORY_COMPACT_BUCKET_MINUTES=15

# Minimum interval between prune/compact passes.
PROFIT_HISTORY_PRUNE_INTERVAL_SECONDS=3600

# ==================== Price Fetch Reliability ====================
PRICE_FETCH_TIMEOUT_SECONDS=10
PRICE_FETCH_MAX_RETRIES=2
PRICE_FETCH_BACKOFF_BASE_SECONDS=0.35
PRICE_FETCH_ERROR_COOLDOWN_SECONDS=20
PRICE_FETCH_RATE_LIMIT_COOLDOWN_SECONDS=60
